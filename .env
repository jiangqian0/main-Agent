ALI_PREFIX_STR=/cloudmind/web
ENV_NAME=ALL
DB_BILL_OWNER_ID=5684930703405044
DEFAULT_BILL_OWNER_ID=5684930703405044
# 数据库类型：mysql / sqlite（默认 mysql）
# 使用 sqlite 时无需配置 MySQL 连接信息，数据库文件保存在 data/ 目录
DB_TYPE=sqlite
# 阿里云 API 端点配置（可选，VPC 内网部署时使用）
#BSS_ENDPOINT=business-vpc.cn-hongkong.aliyuncs.com
BSS_ENDPOINT=business.ap-southeast-1.aliyuncs.com
#RC_ENDPOINT=resourcecenter-intl.vpc-proxy.aliyuncs.com
RC_ENDPOINT=resourcecenter-intl.aliyuncs.com

# STS临时访问密钥ID
ALIBABA_CLOUD_ACCESS_KEY_ID=
# STS临时访问密钥Secret
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

USE_INTERNAL_ENDPOINT=false
RESOURCE_DIRECTORY_ID=rd-EbaBba
NORMALIZE_APP_CODE_UPPER=true
SHOW_ALLOCATE_BUTTON=true
AMOUNT_ROUND_2=false
OPENAI_API_KEY=your-api-key
DASHSCOPE_API_KEY=your-api-key
API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen3-max
WORKSPACE_DIR=./workspace
